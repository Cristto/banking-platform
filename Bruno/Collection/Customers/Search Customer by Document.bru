meta {
  name: Search Customer by Document
  type: http
  seq: 5
}

get {
  url: http://localhost:8081/api/customers?query=12345678A
  auth: none
}

tests {
  test("returns only the customer matching the document query", function () {
    expect(res.getStatus()).to.equal(200);
    const customers = res.getBody();
    expect(customers).to.be.an("array").with.lengthOf(1);
    expect(customers[0].documentNumber).to.equal("12345678A");
  });
}
