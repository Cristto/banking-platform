meta {
  name: List Customers
  type: http
  seq: 4
}

get {
  url: http://localhost:8081/api/customers
  auth: none
}

tests {
  test("returns 200 and a customer array", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });

  test("includes the registered sample customer", function () {
    const customers = res.getBody();
    expect(customers.some(customer => customer.documentNumber === "12345678A")).to.equal(true);
  });
}
