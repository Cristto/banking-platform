meta {
  name: Authorize Purchase - Insufficient Funds
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/accounts/{{insufficientFundsAccountId}}/purchases
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "purchaseReference": "BRU-PURCHASE-INSUFFICIENT-001",
    "merchantName": "Bruno Sample Store",
    "amount": 999999.00
  }
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().detail).to.include("insufficient funds");
  });
}
