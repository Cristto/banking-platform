meta {
  name: Transfer Funds - Same Account (UC03.3)
  type: http
  seq: 7
}

post {
  url: http://localhost:8081/api/accounts/transfers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sourceAccountId": {{sourceAccountId}},
    "destinationAccountId": {{sourceAccountId}},
    "idempotencyKey": "tr-003",
    "amount": 50.00
  }
}

tests {
  test("returns 4xx when source and destination are the same account", function () {
    expect(res.getStatus()).to.be.a("number").and(function (status) {
      return status >= 400 && status < 500;
    });
  });
}
