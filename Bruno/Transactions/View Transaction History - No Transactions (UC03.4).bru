meta {
  name: View Transaction History - No Transactions (UC03.4)
  type: http
  seq: 9
}

get {
  url: http://localhost:8081/api/accounts/{{newAccountId}}/transactions?page=0&size=20
  auth: none
}

headers {
  Content-Type: application/json
}

tests {
  test("returns 200 with empty content", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns empty page", function () {
    const body = res.getBody();
    expect(body.content).to.be.an("array").and(function (content) {
      return content.length === 0;
    });
  });
}
